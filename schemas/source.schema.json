{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "url",
    "title",
    "publisher",
    "published_at",
    "accessed_at"
  ],
  "additionalProperties": false
}
