{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "Academic centers",
        "Commercial firms",
        "Government bodies",
        "Nonprofits & research",
        "Standards & alliances"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "disputed"
      ]
    },
    "political_affiliation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "documented"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "enum": [
              "funding",
              "policy_position",
              "political_affiliation",
              "ownership",
              "assessment",
              "qualifications"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "primary_source",
              "self_disclosure"
            ]
          },
          "review_status": {
            "type": "string",
            "enum": [
              "pending",
              "reviewed",
              "disputed"
            ]
          }
        },
        "required": [
          "id",
          "field",
          "statement",
          "source_ids",
          "evidence_type",
          "review_status"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "summary",
    "website",
    "review_status",
    "political_affiliation",
    "claims",
    "provenance"
  ],
  "additionalProperties": false
}
